# Source material at the repo root (bulk; not part of the site itself).
# Leading "/" anchors to root — PDFs under site/assets/sources/ are kept.
/*.pdf
/*.rar
/*.zip

# Extracted text from source PDFs (regenerated by pdftotext)
/*.txt

# Python
__pycache__/
*.pyc
*.pyo

# Empty placeholder
/Apologetics

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
.claude/

# Extract subdirs (intermediate build output)
ibnmajah-extract/
nasai-extract/
.tmp/
scrape-data/

# Supabase data dumps (contain user data — never commit)
backups/
hadith-sunnah/

# Pristine monolith backups for split_readers.py idempotency (large, regenerable)
site/read/*.orig.html

# Sources pipeline scratch files (regenerated by build_sources.py)
sources-corpus.json
sources-candidates.json
sources-raw.json
sources-unresolved.json
sources-processed.json

# Remotion video sub-project
video/node_modules/
video/out/

# Installed agent skills (reinstall: npx skills add remotion-dev/skills)
.agents/
.claude/skills/remotion-*
.claude/skills/mediabunny

video/capture/shots/
video/capture/node_modules/

video/public/site/

# Visual brainstorming companion sessions
.superpowers/
